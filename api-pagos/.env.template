PORT=3004
NODE_ENV=development

# Base de datos (PostgreSQL)
# Local (docker compose):  postgresql://canchas_user:canchas_pass@localhost:5432/canchas_db
# Supabase (prod):         usar el connection string del Session Pooler (IPv4, puerto 5432)
DATABASE_URL=postgresql://canchas_user:canchas_pass@localhost:5432/canchas_db
# false en local; true en Supabase/prod (requiere SSL)
DATABASE_SSL=false

# Secreto interno: el gateway (y los otros microservicios) lo mandan en cada llamada.
# Debe ser IDÉNTICO en gateway y en los 4 microservicios.
INTERNAL_SECRET=cambiar_este_secreto_interno

# URL de api-turnos (confirma la reserva al cubrir la seña)
# Local: http://localhost:3003   |   Prod: URL pública de api-turnos en Render
TURNOS_URL=http://localhost:3003

# MercadoPago: token de la cuenta del vendedor (usar el de prueba en dev)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# URL del frontend (back_urls de MercadoPago tras el pago)
# Local: http://localhost:5173   |   Prod: URL pública del frontend en Vercel
FRONTEND_URL=http://localhost:5173
