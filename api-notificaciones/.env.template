PORT=3005
NODE_ENV=development

# Secreto interno: api-turnos lo manda en cada llamada. Debe ser IDÉNTICO en gateway y microservicios.
INTERNAL_SECRET=cambiar_este_secreto_interno

# --- SMTP (cualquier proveedor gratuito) ---
# Si SMTP_HOST queda vacío el servicio arranca igual pero NO envía mails (solo loguea).
#
# Opción A - Gmail (gratis, ~500 mails/día). Requiere verificación en 2 pasos y una
#   "contraseña de aplicación": https://myaccount.google.com/apppasswords
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#     SMTP_USER=tu_cuenta@gmail.com  SMTP_PASS=<contraseña de aplicación de 16 letras>
#     MAIL_FROM="ReservaCanchas <tu_cuenta@gmail.com>"
#
# Opción B - Brevo (gratis, 300 mails/día): crear cuenta, verificar un remitente y generar
#   una clave SMTP en https://app.brevo.com/settings/keys/smtp
#     SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
#     SMTP_USER=<login SMTP de Brevo>  SMTP_PASS=<clave SMTP>
#     MAIL_FROM="ReservaCanchas <remitente_verificado@tudominio.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# URL pública del frontend (link "Mis reservas" en el mail al cliente)
FRONTEND_URL=http://localhost:5173
