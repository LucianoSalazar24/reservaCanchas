# Plantilla de variables compartidas por los microservicios.
# Copiar a .env y completar:  cp .env.template .env
# Docker Compose interpola estas variables con ${VAR} en docker-compose.yml.

# --- Base de datos ---
# Postgres corre como servicio "postgres" dentro del propio docker-compose (ver
# docker-compose.yml), tanto en local como luego en el VPS. Al levantar el compose
# por primera vez, el contenedor ejecuta database/schema.sql + database/seed.sql
# automáticamente (docker-entrypoint-initdb.d). Si cambiás usuario/password/db acá,
# actualizá también el bloque "environment" del servicio "postgres" en el compose.
DATABASE_URL=postgresql://canchas_user:canchas_pass@postgres:5432/canchas_db
# false: Postgres propio sin SSL (local y VPS). Solo true si en algún momento vuelven
# a apuntar a un proveedor gestionado (ej. Supabase) que lo exija.
DATABASE_SSL=false

# --- JWT (debe ser IDÉNTICO en gateway y api-usuarios) ---
JWT_SECRET=cambiar_esta_clave_en_produccion

# --- Secreto interno (debe ser IDÉNTICO en gateway y los 4 microservicios) ---
# Autentica al gateway ante los microservicios; sin él, cualquiera podría pegarle
# directo a la URL pública de un microservicio salteándose el gateway.
INTERNAL_SECRET=cambiar_este_secreto_interno

# --- IA (recomendador de canchas en api-canchas) ---
# API key gratuita de Google AI Studio: https://aistudio.google.com/apikey
# Si se deja vacía, GET /canchas/recomendadas sigue funcionando (ranking por
# distancia solo), simplemente sin los motivos generados por IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
